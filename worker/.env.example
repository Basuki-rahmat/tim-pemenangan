# ============================================================
# Worker BullMQ (Batch Insert MySQL) - Contoh Konfigurasi
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# ============================================================

# Antrean & batching
PBATCH_SIZE=500
PFLUSH_INTERVAL_MS=1000

# Redis (di production arahkan ke IP private VPC Redis Cluster)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# MySQL (di production arahkan ke IP private VPC MySQL Primary)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=db_pemilu_c1
DB_POOL=10

# Object Storage untuk membangun image_url
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=c1-uploads
