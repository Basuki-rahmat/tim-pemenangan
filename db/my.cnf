# ============================================================================
# KONFIGURASI MYSQL - PROTOTYPE LOCALHOST (LARAGON WINDOWS) & PRODUCTION
# Issue #01: Setup Skema Database Dinamis & Optimasi High-Throughput
# ============================================================================

[mysqld]
# ----------------------------------------------------------------------------
# 1. CHARSET & COLLATION (Standar UTF-8 Multi-Bahasa & Emoji)
# ----------------------------------------------------------------------------
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci

# ----------------------------------------------------------------------------
# 2. PROFIL LOCALHOST / LARAGON WINDOWS (Aktif untuk Prototype)
# ----------------------------------------------------------------------------
# Buffer pool disesuaikan agar hemat RAM di Windows lokal (1GB - 4GB)
innodb_buffer_pool_size         = 2G
innodb_buffer_pool_instances     = 2

# WAJIB: Kecepatan tulis tinggi tanpa fsync pada setiap commit transaksi
# Menghindari disk I/O bottleneck saat penulisan data massal Form C1
innodb_flush_log_at_trx_commit  = 2

# Ukuran Redo Log (MySQL 8.0.30+ mendukung innodb_redo_log_capacity)
innodb_redo_log_capacity        = 512M

# Di Windows, gunakan 'unbuffered' atau biarkan default (O_DIRECT hanya untuk Linux)
innodb_flush_method             = unbuffered

# Kapasitas koneksi untuk pengujian concurrent / queue batch worker
max_connections                 = 1000
max_connect_errors              = 10000

# Pengaturan Timeout & Paket
max_allowed_packet              = 64M
wait_timeout                    = 600
interactive_timeout             = 600

# Doublewrite buffer tetap aktif untuk keamanan integritas data lokal
innodb_doublewrite              = 1

# Nonaktifkan DNS lookup untuk koneksi localhost cepat (127.0.0.1)
skip-name-resolve               = 1

# ----------------------------------------------------------------------------
# 3. PROFIL PRODUCTION SERVER (Referensi: 32 Core / 128 GB RAM + SSD NVMe Linux)
#    Gunakan nilai di bawah ini saat deploy ke Cloud Server (Biznet Gio / dsb.)
# ----------------------------------------------------------------------------
# [mysqld_production_reference]
# innodb_buffer_pool_size         = 96G
# innodb_buffer_pool_instances     = 16
# innodb_log_file_size            = 8G
# innodb_flush_log_at_trx_commit  = 2
# innodb_flush_method             = O_DIRECT
# max_connections                 = 5000
# innodb_io_capacity              = 20000
# innodb_io_capacity_max          = 40000
# innodb_read_io_threads          = 16
# innodb_write_io_threads         = 16

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
