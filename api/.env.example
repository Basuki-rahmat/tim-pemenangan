# ============================================================
# API Producer - Contoh Konfigurasi Environment
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# ============================================================

NODE_ENV=development
PORT=3000

# MySQL (di production arahkan ke IP private VPC MySQL Primary)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=db_pemilu_c1

# MySQL Read Replica untuk dashboard (kosongkan = pakai DB_HOST)
DB_REPLICA_HOST=
DB_REPLICA_PORT=3306

# Redis (antrean BullMQ c1-queue)
# WAJIB: Redis >= 6.2.0 (BullMQ v5; Redis 5.x memunculkan warning)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# S3-Compatible Object Storage (MinIO lokal / NEO Object Storage)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=c1-uploads
S3_FORCE_PATH_STYLE=true
